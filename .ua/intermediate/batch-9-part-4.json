  "nodes": [
    {
      "id": "file:pages/client/feedback.php",
      "type": "file",
      "name": "feedback.php",
      "filePath": "pages/client/feedback.php",
      "summary": "Client feedback page where a customer submits a review for a completed booking, with Gemini AI sentiment analysis (local keyword/regex fallback), automatic topic tagging, urgent-escalation notifications, and a filterable review history grouped by service type. Not a standalone script: it opens with requireRole('client') and assumes index.php already loaded config.php/functions.php and defined $user, $role and $page.",
      "tags": ["page", "feedback", "ai-integration", "client-portal", "procedural-php"],
      "complexity": "complex",
      "languageNotes": "Procedural PHP template with ~500 lines of inline <style> and ~95 lines of inline <script>. The INSERT into feedback is rebuilt across four branches based on SHOW COLUMNS probing for the optional ai_sentiment / booking_id / topics columns, so the page degrades gracefully on older schemas."
    },
    {
      "id": "function:pages/client/feedback.php:analyzeSentimentLocal",
      "type": "function",
      "name": "analyzeSentimentLocal",
      "filePath": "pages/client/feedback.php",
      "lineRange": [14, 26],
      "summary": "Keyword-scoring sentiment fallback that counts Filipino and English positive/negative terms in a comment and returns 'positive', 'negative' or 'neutral'. Used when analyzeFeedbackWithAI() from ai_helper.php is unavailable or throws.",
      "tags": ["utility", "sentiment", "fallback", "text-analysis"],
      "complexity": "simple"
    },
    {
      "id": "function:pages/client/feedback.php:detectTopicsLocal",
      "type": "function",
      "name": "detectTopicsLocal",
      "filePath": "pages/client/feedback.php",
      "lineRange": [31, 46],
      "summary": "Regex topic detector that tags a comment with any of seven categories (photographer, quality, print, staff, delivery, pricing, studio) and defaults to 'general' when nothing matches. Result is stored as a comma-separated string in feedback.topics.",
      "tags": ["utility", "topic-detection", "regex", "text-analysis"],
      "complexity": "simple"
    },
    {
      "id": "function:pages/client/feedback.php:classifyFeedbackByService",
      "type": "function",
      "name": "classifyFeedbackByService",
      "filePath": "pages/client/feedback.php",
      "lineRange": [51, 76],
      "summary": "Maps a package name to one of five service buckets (self-shoot, creative, family, studio-rental, other) via chained strpos checks, returning a key, display label, emoji icon and theme colour used for service badges and the filter counters.",
      "tags": ["utility", "classification", "service-catalog", "presentation"],
      "complexity": "simple"
    },
    {
      "id": "function:pages/client/feedback.php:getTopicIcon",
      "type": "function",
      "name": "getTopicIcon",
      "filePath": "pages/client/feedback.php",
      "lineRange": [81, 84],
      "summary": "Dictionary lookup returning the emoji icon for a detected feedback topic, falling back to a speech bubble for unknown values.",
      "tags": ["utility", "presentation", "topic-detection", "lookup"],
      "complexity": "simple"
    },
    {
      "id": "function:pages/client/feedback.php:getTopicLabel",
      "type": "function",
      "name": "getTopicLabel",
      "filePath": "pages/client/feedback.php",
      "lineRange": [86, 89],
      "summary": "Returns the human-readable label for a feedback topic, falling back to a ucfirst() of the raw topic string when the topic is not in the map.",
      "tags": ["utility", "presentation", "topic-detection", "lookup"],
      "complexity": "simple"
    },
    {
      "id": "function:pages/client/feedback.php:getTopicColor",
