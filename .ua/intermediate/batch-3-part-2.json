    {
      "id": "function:functions.php:ensureDatabaseSchema",
      "type": "function",
      "name": "ensureDatabaseSchema",
      "filePath": "functions.php",
      "lineRange": [70, 177],
      "summary": "Runtime schema auto-migration guard: inspects users, bookings, payments and packages, ALTERs in any missing columns, MODIFYs the booking status and payment type/status ENUMs, and creates the password_resets table. Guarded by a static flag and swallows failures to the error log.",
      "tags": ["database", "migration", "schema", "utility"],
      "complexity": "complex",
      "languageNotes": "Runs on the first db() call of every request, so the app needs ALTER privileges in production and ENUM changes must be mirrored in sql/install.sql or fresh and migrated installs diverge."
    },
