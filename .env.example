# App URL (optional - auto-detected if omitted)
# For Railway production, set to: https://studio-94.up.railway.app
APP_URL=https://studio-94.up.railway.app

# Database Configuration (optional for local, configured in Railway for production)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=snaptrack
DB_USER=root
DB_PASS=

# Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# PayMongo Payment Gateway
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

MAIL_USERNAME=your_google_username_here
MAIL_PASSWORD=your_generated_app_password_here

# Resend API (Recommended for Railway - uses HTTPS port 443 instead of blocked SMTP ports)
RESEND_API_KEY=your_resend_api_key_here

# Sender address for outbound email.
# Resend's onboarding@resend.dev test domain can ONLY send to your own address.
# To email real clients, verify a domain in Resend and set this, e.g.:
# RESEND_FROM="Studio 94 <no-reply@yourdomain.com>"
RESEND_FROM=

# Brevo (recommended for Railway - 300 emails/day free, no domain needed)
# Brevo dashboard -> SMTP & API -> API Keys -> Generate a v3 key.
# Railway blocks SMTP ports 465/587, so use the HTTPS API, not Brevo SMTP.
BREVO_API_KEY=

# Sender address. Must be a verified sender in Brevo.
# Defaults to MAIL_USERNAME when left empty.
BREVO_FROM_EMAIL=
